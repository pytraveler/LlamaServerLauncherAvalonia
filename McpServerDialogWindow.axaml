<Window x:Class="LlamaServerLauncher.McpServerDialogWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:LlamaServerLauncher.ViewModels;assembly=LlamaServerLauncher"
        mc:Ignorable="d"
        x:DataType="vm:McpServerDialogViewModel"
        Title="{Binding Localized.McpDialogTitle}"
        Width="680" Height="540"
        MinWidth="520" MinHeight="440"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Design.DataContext>
        <vm:McpServerDialogViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="12">
        <Grid Grid.Row="0" ColumnDefinitions="150,*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding Localized.McpName}" VerticalAlignment="Center"
                       Margin="0,0,10,0" ToolTip.Tip="{Binding Localized.TooltipMcpName}"/>
            <TextBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,3"
                     Text="{Binding Entry.Name, UpdateSourceTrigger=PropertyChanged}"
                     PlaceholderText="{Binding Localized.PlaceholderMcpName}"
                     ToolTip.Tip="{Binding Localized.TooltipMcpName}"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding Localized.McpCommand}" VerticalAlignment="Center"
                       Margin="0,0,10,0" ToolTip.Tip="{Binding Localized.TooltipMcpCommand}"/>
            <TextBox Grid.Row="1" Grid.Column="1" Margin="0,3"
                     Text="{Binding Entry.Command, UpdateSourceTrigger=PropertyChanged}"
                     PlaceholderText="{Binding Localized.PlaceholderMcpCommand}"
                     ToolTip.Tip="{Binding Localized.TooltipMcpCommand}"/>
            <Button Grid.Row="1" Grid.Column="2" Content="{Binding Localized.Browse}" Click="BrowseCommandClick"
                    Margin="6,3,0,3" VerticalAlignment="Stretch"/>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding Localized.McpArgs}" VerticalAlignment="Center"
                       Margin="0,0,10,0" ToolTip.Tip="{Binding Localized.TooltipMcpArgs}"/>
            <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,3"
                     Text="{Binding Entry.ArgsText, UpdateSourceTrigger=PropertyChanged}"
                     PlaceholderText="{Binding Localized.PlaceholderMcpArgs}"
                     ToolTip.Tip="{Binding Localized.TooltipMcpArgs}"/>

            <TextBlock Grid.Row="3" Grid.Column="0" Text="{Binding Localized.McpCwd}" VerticalAlignment="Center"
                       Margin="0,0,10,0" ToolTip.Tip="{Binding Localized.TooltipMcpCwd}"/>
            <TextBox Grid.Row="3" Grid.Column="1" Margin="0,3"
                     Text="{Binding Entry.WorkingDirectory, UpdateSourceTrigger=PropertyChanged}"
                     PlaceholderText="{Binding Localized.PlaceholderMcpCwd}"
                     ToolTip.Tip="{Binding Localized.TooltipMcpCwd}"/>
            <Button Grid.Row="3" Grid.Column="2" Content="{Binding Localized.Browse}" Click="BrowseWorkingDirectoryClick"
                    Margin="6,3,0,3" VerticalAlignment="Stretch"/>

            <TextBlock Grid.Row="4" Grid.Column="0" Text="{Binding Localized.McpTimeout}" VerticalAlignment="Center"
                       Margin="0,0,10,0" ToolTip.Tip="{Binding Localized.TooltipMcpTimeout}"/>
            <NumericUpDown Grid.Row="4" Grid.Column="1" Margin="0,3" Width="180" HorizontalAlignment="Left"
                           Value="{Binding TimeoutMs}" Minimum="1000" Maximum="600000" Increment="1000"
                           FormatString="0" ToolTip.Tip="{Binding Localized.TooltipMcpTimeout}"/>

            <TextBlock Grid.Row="5" Grid.Column="0" Text="{Binding Localized.McpEnv}" VerticalAlignment="Top"
                       Margin="0,9,10,0" ToolTip.Tip="{Binding Localized.TooltipMcpEnv}"/>
            <TextBox Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,3" Height="90"
                     AcceptsReturn="True" TextWrapping="NoWrap"
                     VerticalContentAlignment="Top"
                     Text="{Binding Entry.EnvText, UpdateSourceTrigger=PropertyChanged}"
                     PlaceholderText="{Binding Localized.PlaceholderMcpEnv}"
                     ToolTip.Tip="{Binding Localized.TooltipMcpEnv}"/>
        </Grid>

        <TextBlock Grid.Row="1" Text="{Binding ValidationText}" IsVisible="{Binding HasValidationIssues}"
                   Foreground="{DynamicResource WarningForegroundBrush}" TextWrapping="Wrap" Margin="0,10,0,0"/>

        <Border Grid.Row="2" Margin="0,10,0,0" Padding="10" CornerRadius="5"
                Background="{DynamicResource PanelBackgroundBrush}"
                IsVisible="{Binding HasProbeText}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <SelectableTextBlock Text="{Binding ProbeText}" TextWrapping="Wrap"/>
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="3" ColumnDefinitions="Auto,Auto,*,Auto,Auto" Margin="0,12,0,0">
            <Button Grid.Column="0" Content="{Binding Localized.McpTest}" Click="TestClick"
                    IsEnabled="{Binding CanProbe}" MinWidth="90"
                    ToolTip.Tip="{Binding Localized.TooltipMcpTest}"/>
            <Button Grid.Column="1" Content="{Binding Localized.Delete}" Click="DeleteClick"
                    Margin="8,0,0,0" MinWidth="90"
                    ToolTip.Tip="{Binding Localized.McpRemoveServer}"/>
            <Button Grid.Column="3" Content="{Binding Localized.Save}" Click="SaveClick"
                    MinWidth="90" IsDefault="True"/>
            <Button Grid.Column="4" Content="{Binding Localized.Cancel}" Click="CancelClick"
                    Margin="8,0,0,0" MinWidth="90" IsCancel="True"/>
        </Grid>
    </Grid>
</Window>
