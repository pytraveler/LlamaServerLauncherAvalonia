<UserControl x:Class="LlamaServerLauncher.Controls.HistoryTextBox"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <Grid ColumnDefinitions="*,Auto,Auto">
        <TextBox Grid.Column="0"
                 x:Name="InnerTextBox"
                 TextWrapping="NoWrap"/>
        <Button Grid.Column="1"
                x:Name="ClearButton"
                Margin="2,0,0,0"
                Padding="4"
                VerticalAlignment="Stretch"
                ToolTip.Tip="{Binding Localized.Clear}"
                AutomationProperties.Name="{Binding Localized.Clear}"
                Click="ClearButton_Click">
            <PathIcon Width="13" Height="13"
                      Data="M512 608v576q0 14-9 23t-23 9h-64q-14 0-23-9t-9-23V608q0-14 9-23t23-9h64q14 0 23 9t9 23m256 0v576q0 14-9 23t-23 9h-64q-14 0-23-9t-9-23V608q0-14 9-23t23-9h64q14 0 23 9t9 23m256 0v576q0 14-9 23t-23 9h-64q-14 0-23-9t-9-23V608q0-14 9-23t23-9h64q14 0 23 9t9 23m128 724V384H256v948q0 22 7 40.5t14.5 27t10.5 8.5h832q3 0 10.5-8.5t14.5-27t7-40.5M480 256h448l-48-117q-7-9-17-11H546q-10 2-17 11zm928 32v64q0 14-9 23t-23 9h-96v948q0 83-47 143.5t-113 60.5H288q-66 0-113-58.5T128 1336V384H32q-14 0-23-9t-9-23v-64q0-14 9-23t23-9h309l70-167q15-37 54-63t79-26h320q40 0 79 26t54 63l70 167h309q14 0 23 9t9 23"/>
        </Button>
        <Button Grid.Column="2"
                x:Name="HistoryButton"
                Margin="2,0,0,0"
                Padding="4"
                VerticalAlignment="Stretch"
                Click="HistoryButton_Click">
            <PathIcon Data="m1619 552l-742 741q-19 19-45 19t-45-19L45 552q-19-19-19-45.5T45 461l166-165q19-19 45-19t45 19l531 531l531-531q19-19 45-19t45 19l166 165q19 19 19 45.5t-19 45.5"/>
        </Button>
    </Grid>
</UserControl>
